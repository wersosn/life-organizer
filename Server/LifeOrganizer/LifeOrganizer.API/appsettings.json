    "SmtpPort": 2525,
    "SmtpUsername": "YOUR_MAILTRAP_USERNAME",
    "SmtpPassword": "YOUR_MAILTRAP_PASSWORD",
    "FromAddress": "no-reply@lifeorganizer.app",
    "FromName": "LifeOrganizer"
  },
  "App": {
    "BaseUrl": "https://localhost:7297",
    "DeepLinkScheme": "lifeorganizermobile"
  },
  "AllowedHosts": "*"
