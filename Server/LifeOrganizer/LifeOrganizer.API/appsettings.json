{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=LifeOrganizerDB;Username=postgres;Password=postgres",
    "TestConnection": "Host=localhost;Port=5432;Database=LifeOrganizerDB_Tests;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "SECRET_KEY", // Only for development ;)
    "Issuer": "LifeOrganizer",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 60
